      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n\n  .ww-root {\n    --color-brand-bg: #09090b;\n    --color-brand-surface: #18181b;\n    --color-brand-border: #27272a;\n    --color-brand-glow: #4f46e5;\n    --color-brand-purple: #7c3aed;\n    --color-primary: #fafafa;\n    --color-muted: #a1a1aa;\n    --shadow-card-glow: 0 0 20px 1px rgba(79, 70, 229, 0.15);\n    --radius-card: 0.75rem;\n    --radius-pill: 9999px;\n    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;\n  }\n\n  .ww-mono {\n    font-family: 'JetBrains Mono', ui-monospace, monospace;\n  }\n\n  /* Card — transform/border/shadow transitions ONLY (LayoutGroup-safe) */\n  .ww-card {\n    transition:\n      transform 150ms cubic-bezier(0.22, 1, 0.36, 1),\n      border-color 150ms ease-out,\n      box-shadow 150ms ease-out;\n    will-change: transform;\n  }\n\n  .ww-card:hover {\n    transform: translateY(-2px);\n    border-color: color-mix(in srgb, var(--color-brand-glow) 50%, var(--color-brand-border));\n    box-shadow: var(--shadow-card-glow);\n  }\n\n  .ww-card.is-pinned {\n    border-color: rgba(124, 58, 237, 0.4);\n  }\n\n  .ww-card.is-pinned:hover {\n    border-color: color-mix(in srgb, var(--color-brand-purple) 60%, var(--color-brand-border));\n    box-shadow: 0 0 20px 1px rgba(124, 58, 237, 0.15);\n  }\n\n  /* Top hairline gradient, revealed on hover */\n  .ww-hairline {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(79, 70, 229, 0.25), transparent);\n    opacity: 0;\n    transition: opacity 150ms ease-out;\n    pointer-events: none;\n  }\n\n  .ww-card:hover .ww-hairline {\n    opacity: 1;\n  }\n\n  .ww-card.is-pinned .ww-hairline {\n    background: linear-gradient(90deg, transparent, rgba(124, 58, 237, 0.3), transparent);\n    opacity: 1;\n  }\n\n  /* Faint purple corner glow on pinned cards */\n  .ww-pin-glow {\n    position: absolute;\n    top: -24px;\n    right: -24px;\n    width: 96px;\n    height: 96px;\n    border-radius: 9999px;\n    background: radial-gradient(circle, rgba(124, 58, 237, 0.14), transparent 70%);\n    pointer-events: none;\n  }\n\n  /* PlatformLogo monogram tile — intentional radial indigo tint + inner ring */\n  .ww-logo {\n    background:\n      radial-gradient(circle at center, rgba(79, 70, 229, 0.12), transparent 72%),\n      var(--color-brand-bg);\n    box-shadow: inset 0 0 0 1px rgba(79, 70, 229, 0.15);\n  }\n\n  /* Arrow shift on card hover */\n  .ww-arrow {\n    transition: transform 150ms cubic-bezier(0.22, 1, 0.36, 1), color 150ms ease-out;\n  }\n\n  .ww-card:hover .ww-arrow {\n    transform: translate(2px, -2px);\n    color: var(--color-brand-glow);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ww-card,\n    .ww-arrow,\n    .ww-hairline {\n      transition: none !important;\n      transform: none !important;\n    }\n  }\n</style>\n<div class=\"ww-root min-h-screen bg-[var(--color-brand-bg)] text-[var(--color-primary)] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"px-6 py-6\" data-kid=\"1-1\" data-name=\"active view header section\">\n\n<div class=\"mb-6\" data-kid=\"1-1-1\" data-name=\"active view lockup container\">\n<p class=\"text-xs font-medium uppercase tracking-wide text-[var(--color-muted)]\" data-kid=\"1-1-1-1\" data-name=\"active view label\">Active View</p>\n<h2 class=\"text-2xl font-bold text-[var(--color-primary)]\" data-kid=\"1-1-1-2\" data-name=\"active view title\">All Platforms</h2>\n<p class=\"mt-1 text-sm text-[var(--color-muted)]\" data-kid=\"1-1-1-3\" data-name=\"platform count description\">10 listings in Global<span class=\"ww-mono ml-2 text-xs text-[var(--color-brand-purple)]\" data-kid=\"1-1-1-3-1\" data-name=\"pinned count indicator\">· 2 pinned</span></p>\n</div>\n\n<div class=\"grid grid-cols-4 gap-4\" data-kid=\"1-1-2\" data-name=\"platform directory grid container\">\n\n<a class=\"ww-card is-pinned relative flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-brand-border)] bg-[var(--color-brand-surface)] p-4\" data-kid=\"1-1-2-1\" data-name=\"pinned platform card\" href=\"#\">\n<span class=\"ww-hairline\" data-kid=\"1-1-2-1-1\" data-name=\"card top gradient hairline\"></span>\n<span class=\"ww-pin-glow\" data-kid=\"1-1-2-1-2\" data-name=\"pinned card corner glow\"></span>\n<div class=\"relative z-10 mb-3 flex items-start justify-between gap-3\" data-kid=\"1-1-2-1-3\" data-name=\"card header container\">\n<div class=\"flex min-w-0 items-start gap-3\" data-kid=\"1-1-2-1-3-1\" data-name=\"card brand identity group\">\n<div class=\"ww-logo flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-md border border-[var(--color-brand-border)]\" data-kid=\"1-1-2-1-3-1-1\" data-name=\"platform logo tile\">\n<span class=\"text-xs font-semibold text-[var(--color-brand-glow)]\" data-kid=\"1-1-2-1-3-1-1-1\" data-name=\"platform monogram character\">N</span>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-1-2-1-3-1-2\" data-name=\"card title/domain container\">\n<h3 class=\"truncate text-base font-semibold text-[var(--color-primary)]\" data-kid=\"1-1-2-1-3-1-2-1\" data-name=\"platform title text\">Netflix</h3>\n<p class=\"ww-mono mt-1 truncate text-xs text-[var(--color-muted)]\" data-kid=\"1-1-2-1-3-1-2-2\" data-name=\"platform domain text\">netflix.com</p>\n</div>\n</div>\n<div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-1-2-1-3-2\" data-name=\"card actions container\">\n<button aria-label=\"Unpin platform\" class=\"rounded-md p-1 text-[var(--color-brand-purple)]\" data-kid=\"1-1-2-1-3-2-1\" data-name=\"unpin platform button\" type=\"button\">\n<svg data-kid=\"1-1-2-1-3-2-1-1\" data-name=\"star pin icon\" fill=\"currentColor\" height=\"16\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.