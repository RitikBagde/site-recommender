=\"1-1-2-2-3-2-2\" data-name=\"card navigation arrow\" fill=\"none\" height=\"16\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"16\"><path d=\"M7 17 17 7\" data-kid=\"9\"></path><path d=\"M7 7h10v10\" data-kid=\"10\"></path></svg>\n</div>\n</div>\n<p class=\"relative z-10 mb-4 line-clamp-2 flex-1 text-sm text-[var(--color-muted)]\" data-kid=\"1-1-2-2-4\" data-name=\"platform description text\">HBO prestige series, Warner Bros. catalogs, and Max Originals.</p>\n<div class=\"relative z-10 mt-auto flex flex-wrap items-center gap-2\" data-kid=\"1-1-2-2-5\" data-name=\"card metadata footer\">\n<span class=\"rounded-full border border-[rgba(124,58,237,0.3)] bg-[rgba(124,58,237,0.1)] px-2 py-0.5 text-xs font-medium text-[var(--color-primary)]\" data-kid=\"1-1-2-2-5-1\" data-name=\"subscription type badge\">Subscription</span>\n<span class=\"ww-mono inline-flex items-center gap-1 text-xs text-[var(--color-muted)]\" data-kid=\"1-1-2-2-5-2\" data-name=\"availability info text\">\n<svg data-kid=\"1-1-2-2-5-2-1\" data-name=\"external link icon\" fill=\"none\" height=\"12\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"12\"><path d=\"M15 3h6v6\" data-kid=\"11\"></path><path d=\"M10 14 21 3\" data-kid=\"12\"></path><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\" data-kid=\"13\"></path></svg>\n            US · UK +1\n          </span>\n</div>\n</a>\n\n<a class=\"ww-card relative flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-brand-border)] bg-[var(--color-brand-surface)] p-4\" data-kid=\"1-1-2-3\" data-name=\"standard platform card\" href=\"#\">\n<span class=\"ww-hairline\" data-kid=\"1-1-2-3-1\" data-name=\"card top gradient hairline\"></span>\n<div class=\"relative z-10 mb-3 flex items-start justify-between gap-3\" data-kid=\"1-1-2-3-2\" data-name=\"card 